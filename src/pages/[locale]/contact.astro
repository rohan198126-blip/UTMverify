---
import RootLayout from '../../layouts/RootLayout.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = useTranslations(locale);
const canonicalPath = `/${locale}/contact`;
const title = `${t('contact.title')} — UTMVerify`;
---

<RootLayout
  title={title}
  description={t('contact.subtitle')}
  canonicalPath={canonicalPath}
  locale={locale}
>
  <div class="max-w-3xl mx-auto space-y-6 text-[var(--text-primary)]">
    <!-- Header -->
    <div class="space-y-1.5 pb-4 border-b border-[var(--border-subtle)]">
      <h1 class="text-[22px] sm:text-[24px] font-semibold tracking-tight text-[var(--text-primary)]">
        {t('contact.title')}
      </h1>
      <p class="text-[13px] sm:text-[14px] text-[var(--text-secondary)]">
        {t('contact.subtitle')}
      </p>
    </div>

    <!-- Intro -->
    <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
      {t('contact.intro')}
    </p>

    <!-- Contact Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- General Support -->
      <div class="rounded-[var(--radius-lg)] border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-4 sm:p-5 space-y-2 shadow-[var(--card-shadow)]">
        <div class="flex items-center gap-2 text-[var(--accent)]">
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <span class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
            {t('contact.emailLabel')}
          </span>
        </div>
        <a
          href={`mailto:${t('contact.emailValue')}`}
          class="block text-sm sm:text-base font-mono font-medium text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors focus-ring rounded"
        >
          {t('contact.emailValue')}
        </a>
      </div>

      <!-- Privacy Inquiries -->
      <div class="rounded-[var(--radius-lg)] border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-4 sm:p-5 space-y-2 shadow-[var(--card-shadow)]">
        <div class="flex items-center gap-2 text-[var(--accent)]">
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          <span class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
            {t('contact.privacyLabel')}
          </span>
        </div>
        <a
          href={`mailto:${t('contact.privacyValue')}`}
          class="block text-sm sm:text-base font-mono font-medium text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors focus-ring rounded"
        >
          {t('contact.privacyValue')}
        </a>
      </div>
    </div>

    <!-- Response Time Note -->
    <div class="p-4 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-subtle)]/40 text-xs text-[var(--text-secondary)]">
      {t('contact.responseTime')}
    </div>
  </div>
</RootLayout>
