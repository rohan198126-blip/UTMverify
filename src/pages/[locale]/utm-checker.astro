---
import RootLayout from '../../layouts/RootLayout.astro';
import ToolNav from '../../components/common/ToolNav.astro';
import UtmCheckerShell from '../../components/tools/UtmCheckerShell.astro';
import CheckerContent from '../../components/tools/content/CheckerContent.astro';
import OtherToolsGrid from '../../components/common/OtherToolsGrid.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

import { TOOLS } from '../../lib/seo/siteConfig';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = useTranslations(locale);
const canonicalPath = `/${locale}/utm-checker`;
const title = locale === 'en' ? TOOLS.checker.title : `${t('tools.checker.name')} | UTMVerify`;
const description = locale === 'en' ? TOOLS.checker.description : t('tools.checker.shortDesc');
---

<RootLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  locale={locale}
>
  <div class="space-y-5">
    <ToolNav locale={locale} activeTool="checker" />
    <UtmCheckerShell locale={locale} />
    <CheckerContent />
    <OtherToolsGrid locale={locale} currentTool="checker" />
  </div>
</RootLayout>
