---
import RootLayout from '../../layouts/RootLayout.astro';
import ToolNav from '../../components/common/ToolNav.astro';
import UtmCheckerShell from '../../components/tools/UtmCheckerShell.astro';
import OtherToolsGrid from '../../components/common/OtherToolsGrid.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = useTranslations(locale);
const canonicalPath = `/${locale}/`;
---

<RootLayout
  title={t('site.title')}
  description={t('site.description')}
  canonicalPath={canonicalPath}
  locale={locale}
>
  <div class="space-y-5">
    <!-- Homepage Hero: Focused Utility Suite Identity -->
    <div class="text-center space-y-1 pb-1">
      <h1 class="text-[22px] sm:text-[24px] font-semibold tracking-tight text-[var(--text-primary)]">
        UTM<span class="text-[var(--accent)]">Verify</span>
      </h1>
      <p class="text-[13px] sm:text-[14px] text-[var(--text-secondary)] max-w-md mx-auto leading-relaxed">
        {t('site.tagline')}
      </p>
    </div>

    <ToolNav locale={locale} activeTool="checker" />
    <UtmCheckerShell locale={locale} isHomepage={true} />
    <OtherToolsGrid locale={locale} currentTool="checker" />
  </div>
</RootLayout>
