---
import RootLayout from '../../layouts/RootLayout.astro';
import ToolNav from '../../components/common/ToolNav.astro';
import UtmCheckerShell from '../../components/tools/UtmCheckerShell.astro';
import OtherToolsGrid from '../../components/common/OtherToolsGrid.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = useTranslations(locale);
const canonicalPath = `/${locale}/`;
---

<RootLayout
  title={t('site.title')}
  description={t('site.description')}
  canonicalPath={canonicalPath}
  locale={locale}
>
  <div class="space-y-6 sm:space-y-8">
    <!-- Homepage Hero: Confident Editorial SaaS Identity -->
    <div class="text-center pt-8 sm:pt-14 pb-8 sm:pb-10 max-w-2xl mx-auto">
      <p class="text-[13px] sm:text-sm font-medium tracking-wide text-[var(--text-muted)] mb-3">
        UTMVerify
      </p>
      <h1 class="text-[2.25rem] sm:text-[3.25rem] md:text-[3.75rem] font-semibold tracking-[-0.035em] text-[var(--text-primary)] leading-[1.08]">
        {t('site.tagline')}
      </h1>
      <p class="text-[16px] sm:text-[17px] md:text-[18px] text-[var(--text-secondary)] mt-4 max-w-xl mx-auto leading-relaxed font-normal">
        {t('site.description')}
      </p>
    </div>

    <ToolNav locale={locale} activeTool="checker" />
    <UtmCheckerShell locale={locale} isHomepage={true} />
    <OtherToolsGrid locale={locale} currentTool="checker" />
  </div>
</RootLayout>
