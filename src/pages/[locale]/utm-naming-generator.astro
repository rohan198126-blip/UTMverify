---
import RootLayout from '../../layouts/RootLayout.astro';
import ToolNav from '../../components/common/ToolNav.astro';
import UtmNamingShell from '../../components/tools/UtmNamingShell.astro';
import NamingContent from '../../components/tools/content/NamingContent.astro';
import OtherToolsGrid from '../../components/common/OtherToolsGrid.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

import { TOOLS } from '../../lib/seo/siteConfig';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = useTranslations(locale);
const canonicalPath = `/${locale}/utm-naming-generator`;
const title = locale === 'en' ? TOOLS.naming.title : `${t('tools.naming.name')} | UTMVerify`;
const description = locale === 'en' ? TOOLS.naming.description : t('tools.naming.shortDesc');
---

<RootLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  locale={locale}
>
  <div class="space-y-5">
    <ToolNav locale={locale} activeTool="naming" />
    <UtmNamingShell locale={locale} />
    <NamingContent />
    <OtherToolsGrid locale={locale} currentTool="naming" />
  </div>
</RootLayout>
