---
import RootLayout from '../../layouts/RootLayout.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = useTranslations(locale);
const canonicalPath = `/${locale}/terms`;
const title = `${t('terms.title')} — UTMVerify`;
---

<RootLayout
  title={title}
  description={t('terms.intro')}
  canonicalPath={canonicalPath}
  locale={locale}
>
  <article class="max-w-3xl mx-auto space-y-8 text-[var(--text-primary)]">
    <!-- Header -->
    <div class="space-y-1.5 pb-4 border-b border-[var(--border-subtle)]">
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[var(--text-primary)]">
        {t('terms.title')}
      </h1>
      <p class="text-xs text-[var(--text-muted)] font-mono">
        {t('terms.lastUpdated')}
      </p>
    </div>

    <!-- Intro -->
    <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
      {t('terms.intro')}
    </p>

    <!-- Sections Card -->
    <div class="space-y-6 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-5 sm:p-7 shadow-[var(--card-shadow)] text-xs sm:text-sm leading-relaxed text-[var(--text-secondary)]">
      <!-- Section 1 -->
      <section class="space-y-2">
        <h2 class="text-sm sm:text-base font-semibold text-[var(--text-primary)]">
          {t('terms.section1Title')}
        </h2>
        <p>{t('terms.section1Text')}</p>
      </section>

      <!-- Section 2 -->
      <section class="space-y-2 pt-4 border-t border-[var(--border-subtle)]/60">
        <h2 class="text-sm sm:text-base font-semibold text-[var(--text-primary)]">
          {t('terms.section2Title')}
        </h2>
        <p>{t('terms.section2Text')}</p>
      </section>

      <!-- Section 3 -->
      <section class="space-y-2 pt-4 border-t border-[var(--border-subtle)]/60">
        <h2 class="text-sm sm:text-base font-semibold text-[var(--text-primary)]">
          {t('terms.section3Title')}
        </h2>
        <p>{t('terms.section3Text')}</p>
      </section>

      <!-- Section 4 -->
      <section class="space-y-2 pt-4 border-t border-[var(--border-subtle)]/60">
        <h2 class="text-sm sm:text-base font-semibold text-[var(--text-primary)]">
          {t('terms.section4Title')}
        </h2>
        <p>{t('terms.section4Text')}</p>
      </section>

      <!-- Section 5 -->
      <section class="space-y-2 pt-4 border-t border-[var(--border-subtle)]/60">
        <h2 class="text-sm sm:text-base font-semibold text-[var(--text-primary)]">
          {t('terms.section5Title')}
        </h2>
        <p>{t('terms.section5Text')}</p>
      </section>
    </div>
  </article>
</RootLayout>
