---
import RootLayout from '../../layouts/RootLayout.astro';
import ToolNav from '../../components/common/ToolNav.astro';
import BulkUtmShell from '../../components/tools/BulkUtmShell.astro';
import OtherToolsGrid from '../../components/common/OtherToolsGrid.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = useTranslations(locale);
const canonicalPath = `/${locale}/bulk-utm-builder`;
const title = `${t('tools.bulk.name')} | UTMVerify`;
---

<RootLayout
  title={title}
  description={t('tools.bulk.shortDesc')}
  canonicalPath={canonicalPath}
  locale={locale}
>
  <div class="space-y-5">
    <ToolNav locale={locale} activeTool="bulk" />
    <BulkUtmShell locale={locale} />
    <OtherToolsGrid locale={locale} currentTool="bulk" />
  </div>
</RootLayout>
