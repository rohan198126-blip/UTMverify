---
import RootLayout from '../../layouts/RootLayout.astro';
import ToolNav from '../../components/common/ToolNav.astro';
import UtmParserShell from '../../components/tools/UtmParserShell.astro';
import ParserContent from '../../components/tools/content/ParserContent.astro';
import OtherToolsGrid from '../../components/common/OtherToolsGrid.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

import { TOOLS } from '../../lib/seo/siteConfig';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = useTranslations(locale);
const canonicalPath = `/${locale}/utm-parser`;
const title = locale === 'en' ? TOOLS.parser.title : `${t('tools.parser.name')} | UTMVerify`;
const description = locale === 'en' ? TOOLS.parser.description : t('tools.parser.shortDesc');
---

<RootLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  locale={locale}
>
  <div class="space-y-5">
    <ToolNav locale={locale} activeTool="parser" />
    <UtmParserShell locale={locale} />
    <ParserContent />
    <OtherToolsGrid locale={locale} currentTool="parser" />
  </div>
</RootLayout>
