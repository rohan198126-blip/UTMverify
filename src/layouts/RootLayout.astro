---
import BaseHead from '../components/seo/BaseHead.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import type { SupportedLocale } from '../i18n/ui';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  locale?: SupportedLocale;
  robots?: string;
}

const { title, description, canonicalPath, locale = 'en', robots } = Astro.props;
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      locale={locale}
      robots={robots}
    />
  </head>
  <body class="bg-[var(--bg-app)] text-[var(--text-primary)] min-h-screen flex flex-col font-sans antialiased relative transition-colors duration-150">
    <!-- Overhead Studio Ambient Lighting (broad atmospheric ceiling light spanning across the viewport) -->
    <div class="ambient-lighting-container" aria-hidden="true">
      <div class="ambient-light-wide-canopy"></div>
      <div class="ambient-light-field"></div>
      <div class="ambient-light-core"></div>
      <div class="ambient-light-spill"></div>
    </div>

    <Header locale={locale} currentPath={canonicalPath} />

    <main class="flex-1 w-full max-w-[980px] mx-auto px-4 sm:px-6 py-8 sm:py-14 z-10">
      <slot />
    </main>

    <Footer locale={locale} />
  </body>
</html>

<style is:global>
  /* ------------------------------------------------------------------ */
  /* Overhead Studio Lighting — Wide Viewport Span, Zero Edge Artefact  */
  /* Simulates a massive ceiling/studio light hanging above the website,*/
  /* illuminating the entire top region with horizontal & vertical fade.*/
  /* ------------------------------------------------------------------ */
  .ambient-lighting-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 700px;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
    /* Soft vertical mask ensuring an imperceptible fade into true black */
    mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.85) 45%,
      rgba(0, 0, 0, 0.3) 75%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.85) 45%,
      rgba(0, 0, 0, 0.3) 75%,
      transparent 100%
    );
  }

  /* Layer 1: Wide Canopy — Spans 90-100% of the viewport width across the header */
  .ambient-light-wide-canopy {
    position: absolute;
    top: -260px;
    left: 50%;
    transform: translateX(-50%);
    width: 1700px;
    max-width: 98vw;
    height: 480px;
    background: radial-gradient(
      ellipse 65% 42% at 50% 45%,
      rgba(255, 255, 255, 0.13) 0%,
      rgba(255, 255, 255, 0.07) 35%,
      rgba(255, 255, 255, 0.02) 65%,
      transparent 88%
    );
    filter: blur(80px);
    opacity: 0.95;
  }

  /* Layer 2: Atmospheric Mid-Field — Seamless bridge from center to sides */
  .ambient-light-field {
    position: absolute;
    top: -220px;
    left: 50%;
    transform: translateX(-50%);
    width: 1350px;
    max-width: 94vw;
    height: 520px;
    background: radial-gradient(
      ellipse 58% 48% at 50% 42%,
      rgba(255, 255, 255, 0.16) 0%,
      rgba(255, 255, 255, 0.08) 35%,
      rgba(255, 255, 255, 0.02) 68%,
      transparent 90%
    );
    filter: blur(75px);
    opacity: 0.9;
  }

  /* Layer 3: Top-Center Luminance Core — Natural brightest overhead focus */
  .ambient-light-core {
    position: absolute;
    top: -180px;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    max-width: 85vw;
    height: 380px;
    background: radial-gradient(
      ellipse 50% 50% at 50% 45%,
      rgba(255, 255, 255, 0.22) 0%,
      rgba(255, 255, 255, 0.11) 40%,
      rgba(255, 255, 255, 0.03) 70%,
      transparent 85%
    );
    filter: blur(55px);
    opacity: 0.95;
  }

  /* Layer 4: Subtle Hero Spill — Soft downward dissipation into upper hero */
  .ambient-light-spill {
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 1100px;
    max-width: 92vw;
    height: 620px;
    background: radial-gradient(
      ellipse 50% 50% at 50% 32%,
      rgba(255, 255, 255, 0.06) 0%,
      rgba(255, 255, 255, 0.02) 45%,
      transparent 75%
    );
    filter: blur(105px);
    opacity: 0.85;
  }

  /* Header stays deep dark / near-black while transmitting the broad overhead atmosphere */
  .header-root {
    background: rgba(6, 7, 9, 0.70) !important;
  }

  @media (max-width: 1024px) {
    .ambient-light-wide-canopy {
      width: 1200px;
      height: 420px;
      top: -220px;
      filter: blur(65px);
    }
    .ambient-light-field {
      width: 980px;
      height: 440px;
      top: -180px;
      filter: blur(60px);
    }
    .ambient-light-core {
      width: 700px;
      height: 320px;
      top: -150px;
      filter: blur(48px);
    }
    .ambient-light-spill {
      width: 850px;
      height: 520px;
      top: -80px;
      filter: blur(85px);
    }
  }

  @media (max-width: 768px) {
    .ambient-lighting-container {
      height: 500px;
    }
    .ambient-light-wide-canopy {
      width: 850px;
      height: 360px;
      top: -190px;
      filter: blur(55px);
    }
    .ambient-light-field {
      width: 680px;
      height: 380px;
      top: -160px;
      filter: blur(50px);
    }
    .ambient-light-core {
      width: 520px;
      height: 280px;
      top: -130px;
      filter: blur(40px);
    }
    .ambient-light-spill {
      width: 620px;
      height: 440px;
      top: -60px;
      filter: blur(70px);
    }
  }

  @media (max-width: 480px) {
    .ambient-lighting-container {
      height: 380px;
    }
    .ambient-light-wide-canopy {
      width: 500px;
      height: 280px;
      top: -140px;
      filter: blur(45px);
    }
    .ambient-light-field {
      width: 420px;
      height: 280px;
      top: -120px;
      filter: blur(40px);
    }
    .ambient-light-core {
      width: 340px;
      height: 220px;
      top: -100px;
      filter: blur(32px);
    }
    .ambient-light-spill {
      display: none;
    }
  }

  /* ------------------------------------------------------------------ */
  /* Light Mode Ambient Treatment — Ultra-soft, delicate warm top sheen */
  /* Replaces dark studio glow with a faint, clean editorial top fade   */
  /* ------------------------------------------------------------------ */
  html.light .ambient-lighting-container {
    height: 480px;
    mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.4) 50%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.4) 50%,
      transparent 100%
    );
  }

  html.light .ambient-light-wide-canopy {
    background: radial-gradient(
      ellipse 70% 45% at 50% 30%,
      rgba(0, 0, 0, 0.02) 0%,
      rgba(0, 0, 0, 0.005) 50%,
      transparent 85%
    );
    filter: blur(80px);
    opacity: 0.6;
  }

  html.light .ambient-light-field {
    display: none;
  }

  html.light .ambient-light-core {
    background: radial-gradient(
      ellipse 50% 50% at 50% 35%,
      rgba(255, 255, 255, 0.8) 0%,
      rgba(255, 255, 255, 0.4) 45%,
      transparent 80%
    );
    filter: blur(40px);
    opacity: 0.7;
  }

  html.light .ambient-light-spill {
    display: none;
  }
</style>
