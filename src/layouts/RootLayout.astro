---
import BaseHead from '../components/seo/BaseHead.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import type { SupportedLocale } from '../i18n/ui';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  locale?: SupportedLocale;
}

const { title, description, canonicalPath, locale = 'en' } = Astro.props;
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      locale={locale}
    />
  </head>
  <body class="bg-[var(--bg-app)] text-[var(--text-primary)] min-h-screen flex flex-col font-sans antialiased relative transition-colors duration-150">
    <!-- Ambient overhead lighting (dark mode only) -->
    <div class="ambient-lighting-container" aria-hidden="true">
      <div class="ambient-light-horizon"></div>
      <div class="ambient-light-core"></div>
      <div class="ambient-light-spread"></div>
    </div>

    <Header locale={locale} currentPath={canonicalPath} />

    <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 py-5 sm:py-8 z-10">
      <slot />
    </main>

    <Footer locale={locale} />
  </body>
</html>

<style is:global>
  /* Focus Ring */
  .focus-ring { outline: none; }
  .focus-ring:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* No-scrollbar utility */
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  /* ------------------------------------------------------------------ */
  /* Ambient overhead lighting — dark mode only                          */
  /* ------------------------------------------------------------------ */
  .ambient-lighting-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 350px;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  /*
   * Horizon emission line — sharp, bright origin at top center.
   */
  .ambient-light-horizon {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 560px;
    max-width: 75vw;
    height: 2px;
    background: radial-gradient(
      ellipse at center,
      rgba(255, 255, 255, 0.98) 0%,
      rgba(255, 255, 255, 0.55) 35%,
      transparent 100%
    );
    box-shadow: 0 0 40px 14px rgba(255, 255, 255, 0.42);
  }

  /*
   * Spotlight core — downward cone originating from ceiling center.
   * Illuminates header & hero region; clearly noticeable on dark monitors.
   * Steep falloff keeps main workspace deep black.
   */
  .ambient-light-core {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 580px;
    max-width: 80vw;
    height: 230px;
    background: radial-gradient(
      ellipse 46% 55% at 50% 0%,
      rgba(255, 255, 255, 0.28) 0%,
      rgba(255, 255, 255, 0.14) 35%,
      rgba(255, 255, 255, 0.04) 60%,
      transparent 85%
    );
    filter: blur(26px);
  }

  /*
   * Atmospheric falloff — soft ambient wash fading before main workspace.
   */
  .ambient-light-spread {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 780px;
    max-width: 90vw;
    height: 310px;
    background: radial-gradient(
      ellipse 50% 45% at 50% 0%,
      rgba(255, 255, 255, 0.13) 0%,
      rgba(255, 255, 255, 0.04) 40%,
      transparent 70%
    );
    filter: blur(44px);
  }

  /* Hide ambient lights in Light Mode */
  html.light .ambient-lighting-container {
    display: none !important;
  }
</style>
