---
import { useTranslations } from '../../i18n/utils';
import type { SupportedLocale } from '../../i18n/ui';

export interface Props {
  locale?: SupportedLocale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
---

<div class="w-full max-w-3xl mx-auto space-y-5" id="utm-parser-container">
  <!-- Hero: clean floating typography, no card -->
  <div class="text-center">
    <h1 class="text-[23px] sm:text-[24px] font-semibold tracking-tight text-[var(--text-primary)]">
      {t('parser.heading')}
    </h1>
    <p class="text-[13px] sm:text-[14px] text-[var(--text-secondary)] mt-1.5 max-w-sm mx-auto leading-relaxed">
      {t('parser.subheading')}
    </p>
  </div>

  <!-- Main Input -->
  <div class="rounded-[var(--radius-lg)] border border-[var(--border-strong)] bg-[var(--bg-surface)] p-4 sm:p-5 shadow-[var(--card-shadow)] space-y-3.5">
    <div class="space-y-1.5">
      <div class="flex items-center justify-between">
        <label for="parser-input" class="text-[13px] font-medium text-[var(--text-primary)]">
          {t('parser.inputLabel')}
        </label>
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="parser-example-btn"
            class="btn-inline focus-ring cursor-pointer"
          >
            {t('parser.useExample')}
          </button>
          <span class="text-[var(--text-muted)] text-[11px]">·</span>
          <button
            type="button"
            id="parser-clear-btn"
            class="btn-inline text-[var(--text-muted)] focus-ring cursor-pointer"
          >
            {t('parser.clear')}
          </button>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-2.5">
        <input
          id="parser-input"
          type="text"
          name="campaignUrl"
          spellcheck="false"
          autocomplete="off"
          placeholder={t('parser.inputPlaceholder')}
          class="input-field flex-1 h-10 sm:h-11 focus-ring"
        />
        <button
          type="button"
          id="parser-submit-btn"
          class="btn-primary h-10 sm:h-11 px-5 text-[13px] focus-ring cursor-pointer shrink-0"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
          <span>{t('parser.parse')}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Initial / Empty State — compact, no border -->
  <div
    id="parser-empty-state"
    class="py-6 text-center"
  >
    <svg class="w-5 h-5 mx-auto mb-2 text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
    </svg>
    <div class="text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">{t('parser.emptyTitle')}</div>
    <p class="text-xs text-[var(--text-muted)] mt-0.5 max-w-xs mx-auto leading-relaxed">
      {t('parser.emptyDesc')}
    </p>
  </div>

  <!--
    Results — unified workspace card.
    All sections flow top-to-bottom with internal dividers.
    The eye doesn't have to jump between separate card borders.
  -->
  <div id="parser-results" class="hidden">
    <div class="rounded-[var(--radius-lg)] border border-[var(--border-subtle)] bg-[var(--bg-surface)] shadow-[var(--card-shadow)] overflow-hidden">

      <!-- 1. URL Overview -->
      <div class="px-4 sm:px-5 pt-4 sm:pt-5 pb-4">
        <div class="flex items-center justify-between mb-3">
          <span class="label-caps">{t('parser.overview')}</span>
          <button
            type="button"
            id="copy-dest-btn"
            class="btn-ghost h-7 px-2 text-[11px] focus-ring cursor-pointer"
            data-label-default={t('parser.copyDestination')}
            data-label-copied={t('parser.copied')}
          >
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <span id="copy-dest-label">{t('parser.copyDestination')}</span>
          </button>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-[13px]" id="overview-grid">
          <!-- Injected via client script -->
        </div>
      </div>

      <!-- Duplicate Parameters Warning (inline, inside card) -->
      <div
        id="duplicates-card"
        class="hidden mx-4 sm:mx-5 mb-4 p-3 rounded-[var(--radius-md)] border border-amber-500/25 bg-amber-500/6 text-[13px]"
      >
        <div class="flex items-center gap-2 font-semibold text-amber-500 mb-2">
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          <span>{t('parser.duplicates')}</span>
        </div>
        <div id="duplicates-list" class="space-y-1 font-mono text-[11px] text-[var(--text-secondary)] pl-5">
          <!-- Injected via client script -->
        </div>
      </div>

      <!-- 2. Standard UTM Parameters — divider separated -->
      <div id="utm-card" class="hidden border-t border-[var(--border-subtle)]">
        <div class="px-4 sm:px-5 py-3.5">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              <span class="label-caps">{t('parser.utmParameters')}</span>
              <span id="utm-count-badge" class="px-1.5 py-0.5 rounded-[var(--radius-sm)] text-[10px] font-mono bg-[var(--accent-subtle)] text-[var(--accent)] font-semibold">0</span>
            </div>
            <button
              type="button"
              id="copy-utm-btn"
              class="btn-ghost h-7 px-2 text-[11px] focus-ring cursor-pointer"
              data-label-default={t('parser.copyUtm')}
              data-label-copied={t('parser.copied')}
            >
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              <span id="copy-utm-label">{t('parser.copyUtm')}</span>
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-[13px] font-mono">
              <thead>
                <tr class="border-b border-[var(--border-subtle)] text-[var(--text-muted)] text-[11px]">
                  <th class="py-2 pr-4 font-medium w-1/3">{t('parser.paramCol')}</th>
                  <th class="py-2 font-medium">{t('parser.valueCol')}</th>
                </tr>
              </thead>
              <tbody id="utm-tbody" class="divide-y divide-[var(--border-subtle)]/50">
                <!-- Injected via client script -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 3. Other Query Parameters — divider separated -->
      <div id="custom-card" class="hidden border-t border-[var(--border-subtle)]">
        <div class="px-4 sm:px-5 py-3.5">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              <span class="label-caps">{t('parser.otherParameters')}</span>
              <span id="custom-count-badge" class="px-1.5 py-0.5 rounded-[var(--radius-sm)] text-[10px] font-mono bg-[var(--bg-subtle)] text-[var(--text-secondary)] font-semibold">0</span>
            </div>
            <button
              type="button"
              id="copy-all-btn"
              class="btn-ghost h-7 px-2 text-[11px] focus-ring cursor-pointer"
              data-label-default={t('parser.copyAll')}
              data-label-copied={t('parser.copied')}
            >
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              <span id="copy-all-label">{t('parser.copyAll')}</span>
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-[13px] font-mono">
              <thead>
                <tr class="border-b border-[var(--border-subtle)] text-[var(--text-muted)] text-[11px]">
                  <th class="py-2 pr-4 font-medium w-1/3">{t('parser.paramCol')}</th>
                  <th class="py-2 font-medium">{t('parser.valueCol')}</th>
                </tr>
              </thead>
              <tbody id="custom-tbody" class="divide-y divide-[var(--border-subtle)]/50">
                <!-- Injected via client script -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 4. No Parameters Fallback -->
      <div
        id="no-params-card"
        class="hidden px-4 sm:px-5 py-5 text-center text-[13px] text-[var(--text-secondary)] border-t border-[var(--border-subtle)]"
      >
        {t('parser.noParameters')}
      </div>

    </div>
  </div>
</div>

<script>
  import { parseCampaignUrl, type ParsedCampaignUrl } from '../../lib/utm/index.ts';

  const EXAMPLE_URL =
    'https://example.com/landing-page?ref=homepage&utm_source=google&utm_medium=cpc&utm_campaign=summer_sale&utm_content=banner#pricing';

  function initParser() {
    const input = document.getElementById('parser-input') as HTMLInputElement | null;
    const submitBtn = document.getElementById('parser-submit-btn') as HTMLButtonElement | null;
    const exampleBtn = document.getElementById('parser-example-btn') as HTMLButtonElement | null;
    const clearBtn = document.getElementById('parser-clear-btn') as HTMLButtonElement | null;

    const emptyState = document.getElementById('parser-empty-state') as HTMLElement | null;
    const resultsContainer = document.getElementById('parser-results') as HTMLElement | null;

    const overviewGrid = document.getElementById('overview-grid') as HTMLElement | null;
    const copyDestBtn = document.getElementById('copy-dest-btn') as HTMLButtonElement | null;
    const copyDestLabel = document.getElementById('copy-dest-label') as HTMLElement | null;

    const duplicatesCard = document.getElementById('duplicates-card') as HTMLElement | null;
    const duplicatesList = document.getElementById('duplicates-list') as HTMLElement | null;

    const utmCard = document.getElementById('utm-card') as HTMLElement | null;
    const utmCountBadge = document.getElementById('utm-count-badge') as HTMLElement | null;
    const utmTbody = document.getElementById('utm-tbody') as HTMLElement | null;
    const copyUtmBtn = document.getElementById('copy-utm-btn') as HTMLButtonElement | null;
    const copyUtmLabel = document.getElementById('copy-utm-label') as HTMLElement | null;

    const customCard = document.getElementById('custom-card') as HTMLElement | null;
    const customCountBadge = document.getElementById('custom-count-badge') as HTMLElement | null;
    const customTbody = document.getElementById('custom-tbody') as HTMLElement | null;
    const copyAllBtn = document.getElementById('copy-all-btn') as HTMLButtonElement | null;
    const copyAllLabel = document.getElementById('copy-all-label') as HTMLElement | null;

    const noParamsCard = document.getElementById('no-params-card') as HTMLElement | null;

    if (!input || !emptyState || !resultsContainer || !overviewGrid) return;
    const activeInput = input;

    let currentParsed: ParsedCampaignUrl | null = null;

    function renderResults(data: ParsedCampaignUrl) {
      currentParsed = data;

      if (!data.originalUrl) {
        emptyState?.classList.remove('hidden');
        resultsContainer?.classList.add('hidden');
        return;
      }

      emptyState?.classList.add('hidden');
      resultsContainer?.classList.remove('hidden');

      // 1. Overview Grid
      if (overviewGrid) {
        overviewGrid.textContent = '';

        const items: Array<{ label: string; value: string; fullWidth?: boolean; isMono?: boolean }> = [];

        if (data.baseUrl) {
          items.push({ label: 'Destination', value: data.baseUrl, fullWidth: true, isMono: true });
        }
        if (data.protocol) {
          items.push({ label: 'Protocol', value: data.protocol });
        }
        if (data.hostname) {
          items.push({ label: 'Hostname', value: data.hostname, isMono: true });
        }
        if (data.pathname && data.pathname !== '/') {
          items.push({ label: 'Path', value: data.pathname, isMono: true });
        }
        if (data.fragment) {
          items.push({ label: 'Fragment', value: `#${data.fragment}`, isMono: true });
        }
        items.push({ label: 'Total Parameters', value: String(data.totalParameters) });

        for (const item of items) {
          const div = document.createElement('div');
          div.className = `p-3 rounded-[var(--radius-md)] border border-[var(--border-subtle)] bg-[var(--bg-subtle)]/40 flex flex-col justify-between gap-1 ${
            item.fullWidth ? 'sm:col-span-2' : ''
          }`;

          const lbl = document.createElement('span');
          lbl.className = 'text-[11px] font-medium text-[var(--text-muted)]';
          lbl.textContent = item.label;

          const val = document.createElement('span');
          val.className = `text-[13px] text-[var(--text-primary)] break-all select-all ${item.isMono ? 'font-mono' : 'font-semibold'}`;
          val.textContent = item.value;

          div.appendChild(lbl);
          div.appendChild(val);
          overviewGrid.appendChild(div);
        }
      }

      // 2. Duplicates Card
      if (duplicatesCard && duplicatesList) {
        if (data.hasDuplicates) {
          duplicatesCard.classList.remove('hidden');
          duplicatesList.textContent = '';
          for (const dup of data.duplicates) {
            const p = document.createElement('p');
            const keySpan = document.createElement('span');
            keySpan.className = 'font-semibold text-[var(--text-primary)]';
            keySpan.textContent = `${dup.key}: `;
            p.appendChild(keySpan);

            const valsSpan = document.createElement('span');
            valsSpan.textContent = dup.values.map((v) => `"${v}"`).join(', ');
            p.appendChild(valsSpan);
            duplicatesList.appendChild(p);
          }
        } else {
          duplicatesCard.classList.add('hidden');
        }
      }

      // 3. Standard UTM Table
      if (utmCard && utmTbody && utmCountBadge) {
        if (data.hasUtm) {
          utmCard.classList.remove('hidden');
          utmCountBadge.textContent = String(data.standardParams.length);
          utmTbody.textContent = '';

          for (const param of data.standardParams) {
            const tr = document.createElement('tr');
            tr.className = 'hover:bg-[var(--bg-subtle)]/30 transition-colors';

            const tdKey = document.createElement('td');
            tdKey.className = 'py-2.5 pr-4 text-[var(--accent)] font-semibold';
            tdKey.textContent = param.key;

            const tdVal = document.createElement('td');
            tdVal.className = 'py-2.5 text-[var(--text-primary)] break-all select-all';
            tdVal.textContent = param.value !== '' ? param.value : '—';
            if (param.value === '') {
              tdVal.className += ' text-[var(--text-muted)] italic';
            }

            tr.appendChild(tdKey);
            tr.appendChild(tdVal);
            utmTbody.appendChild(tr);
          }
        } else {
          utmCard.classList.add('hidden');
        }
      }

      // 4. Other Custom Parameters Table
      if (customCard && customTbody && customCountBadge) {
        if (data.hasCustom) {
          customCard.classList.remove('hidden');
          customCountBadge.textContent = String(data.customParams.length);
          customTbody.textContent = '';

          for (const param of data.customParams) {
            const tr = document.createElement('tr');
            tr.className = 'hover:bg-[var(--bg-subtle)]/30 transition-colors';

            const tdKey = document.createElement('td');
            tdKey.className = 'py-2.5 pr-4 text-[var(--text-secondary)] font-medium';
            tdKey.textContent = param.key;

            const tdVal = document.createElement('td');
            tdVal.className = 'py-2.5 text-[var(--text-primary)] break-all select-all';
            tdVal.textContent = param.value !== '' ? param.value : '—';
            if (param.value === '') {
              tdVal.className += ' text-[var(--text-muted)] italic';
            }

            tr.appendChild(tdKey);
            tr.appendChild(tdVal);
            customTbody.appendChild(tr);
          }
        } else {
          customCard.classList.add('hidden');
        }
      }

      // 5. No Parameters Notice
      if (noParamsCard) {
        if (data.totalParameters === 0 && data.isValid) {
          noParamsCard.classList.remove('hidden');
        } else {
          noParamsCard.classList.add('hidden');
        }
      }
    }

    function parseNow() {
      const val = activeInput.value.trim();
      const parsed = parseCampaignUrl(val);
      renderResults(parsed);
    }

    // Event listeners
    activeInput.addEventListener('input', parseNow);
    submitBtn?.addEventListener('click', parseNow);

    activeInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        parseNow();
      }
    });

    // Use Example button
    exampleBtn?.addEventListener('click', () => {
      activeInput.value = EXAMPLE_URL;
      parseNow();
      activeInput.focus();
    });

    // Clear button
    clearBtn?.addEventListener('click', () => {
      activeInput.value = '';
      parseNow();
      activeInput.focus();
    });

    // Clipboard copy helper with feedback
    async function copyWithFeedback(button: HTMLElement | null, labelEl: HTMLElement | null, text: string) {
      if (!button || !labelEl || !text) return;
      const defaultText = button.getAttribute('data-label-default') || labelEl.textContent || 'Copy';
      const copiedText = button.getAttribute('data-label-copied') || 'Copied!';

      try {
        await navigator.clipboard.writeText(text);
        labelEl.textContent = copiedText;
        setTimeout(() => {
          labelEl.textContent = defaultText;
        }, 2000);
      } catch {
        if (navigator.clipboard) {
          navigator.clipboard.writeText(text).catch(() => {});
        }
      }
    }

    // Copy Destination
    copyDestBtn?.addEventListener('click', () => {
      if (currentParsed?.baseUrl) {
        copyWithFeedback(copyDestBtn, copyDestLabel, currentParsed.baseUrl);
      }
    });

    // Copy UTMs
    copyUtmBtn?.addEventListener('click', () => {
      if (currentParsed && currentParsed.standardParams.length > 0) {
        const lines = currentParsed.standardParams.map((p) => `${p.key}: ${p.value}`).join('\n');
        copyWithFeedback(copyUtmBtn, copyUtmLabel, lines);
      }
    });

    // Copy All Parameters
    copyAllBtn?.addEventListener('click', () => {
      if (currentParsed && currentParsed.allParams.length > 0) {
        const lines = currentParsed.allParams.map((p) => `${p.key}: ${p.value}`).join('\n');
        copyWithFeedback(copyAllBtn, copyAllLabel, lines);
      }
    });

    // Initial check on load
    if (activeInput.value.trim()) {
      parseNow();
    }
  }

  initParser();
  document.addEventListener('astro:after-swap', initParser);
</script>
