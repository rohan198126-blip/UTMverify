---
import { useTranslations } from '../../i18n/utils';
import type { SupportedLocale } from '../../i18n/ui';

export interface Props {
  locale?: SupportedLocale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
---

<div class="w-full max-w-3xl mx-auto space-y-5">
  <div class="text-center space-y-1.5">
    <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text-primary)]">
      {t('parser.heading')}
    </h1>
    <p class="text-xs sm:text-sm text-[var(--text-secondary)] max-w-md mx-auto">
      {t('parser.subheading')}
    </p>
  </div>

  <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-4 sm:p-5 shadow-[var(--card-shadow)] space-y-4">
    <div class="space-y-1">
      <label class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
        {t('parser.urlLabel')}
      </label>
      <input
        type="text"
        disabled
        placeholder="https://example.com/shop?utm_source=facebook&utm_medium=paid_social&utm_campaign=retargeting"
        class="w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-input)] px-3.5 py-2 text-xs sm:text-sm font-mono text-[var(--text-muted)] placeholder:text-[var(--text-muted)] cursor-not-allowed opacity-80"
      />
    </div>

    <!-- Parameter breakdown layout shell -->
    <div class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-subtle)]/50 p-3.5 space-y-2">
      <div class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">{t('parser.breakdownTitle')}</div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-[var(--text-secondary)] font-mono">
        <div class="p-2 rounded bg-[var(--bg-surface)] border border-[var(--border-subtle)] flex justify-between">
          <span class="text-[var(--text-muted)]">{t('parser.basePath')}</span>
          <span class="text-[var(--text-primary)]">--</span>
        </div>
        <div class="p-2 rounded bg-[var(--bg-surface)] border border-[var(--border-subtle)] flex justify-between">
          <span class="text-[var(--text-muted)]">utm_source</span>
          <span class="text-[var(--text-primary)]">--</span>
        </div>
        <div class="p-2 rounded bg-[var(--bg-surface)] border border-[var(--border-subtle)] flex justify-between">
          <span class="text-[var(--text-muted)]">utm_medium</span>
          <span class="text-[var(--text-primary)]">--</span>
        </div>
        <div class="p-2 rounded bg-[var(--bg-surface)] border border-[var(--border-subtle)] flex justify-between">
          <span class="text-[var(--text-muted)]">utm_campaign</span>
          <span class="text-[var(--text-primary)]">--</span>
        </div>
      </div>
    </div>
  </div>
</div>
