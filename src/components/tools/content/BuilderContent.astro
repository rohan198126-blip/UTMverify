      }
    },
    {
      "@type": "Question",
      "name": "Why does the builder use %20 instead of + for spaces?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standard RFC 3986 specifies that spaces in URLs are encoded as %20. Many modern web routers and analytics APIs parse + literally rather than as a space, causing attribution errors."
      }
    },
    {
