---
import { useTranslations } from '../../i18n/utils';
import type { SupportedLocale } from '../../i18n/ui';

export interface Props {
  locale?: SupportedLocale;
  activeTool?: 'checker' | 'builder' | 'parser' | 'naming' | 'bulk';
}

const { locale = 'en', activeTool = 'checker' } = Astro.props;
const t = useTranslations(locale);

const tools = [
  { key: 'checker', name: t('tools.checker.name'), path: `/${locale}/utm-checker` },
  { key: 'builder', name: t('tools.builder.name'), path: `/${locale}/utm-builder` },
  { key: 'parser', name: t('tools.parser.name'), path: `/${locale}/utm-parser` },
  { key: 'naming', name: t('tools.naming.name'), path: `/${locale}/utm-naming-generator` },
  { key: 'bulk', name: t('tools.bulk.name'), path: `/${locale}/bulk-utm-builder` },
];
---

<!--
  Tab bar — replaces the old pill/segmented control.
  Uses a simple bottom-border divider with tab-style active state.
  Feels closer to VS Code / Linear than a rounded segmented control.
-->
<nav
  aria-label="Tool selection"
  class="w-full max-w-[980px] mx-auto mb-8 sm:mb-10"
>
  <div class="flex items-center justify-start sm:justify-center overflow-x-auto no-scrollbar border-b border-[var(--border-hairline)] px-2 sm:px-0 gap-1 sm:gap-2">
    {tools.map((tool) => {
      const isActive = activeTool === tool.key;
      return (
        <a
          href={tool.path}
          class={`tool-tab flex-shrink-0 px-4 py-3 text-[14px] sm:text-[15px] tracking-[-0.01em] whitespace-nowrap transition-colors duration-150 focus-ring relative ${
            isActive
              ? 'text-[var(--text-primary)] font-medium tab-active'
              : 'text-[var(--text-muted)] hover:text-[var(--text-primary)] font-normal'
          }`}
          aria-current={isActive ? 'page' : undefined}
        >
          {tool.name}
        </a>
      );
    })}
  </div>
</nav>

<style>
  /* Active tab: subtle bottom border indicator */
  .tool-tab.tab-active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 16px;
    right: 16px;
    height: 2px;
    background: var(--accent);
  }
</style>
