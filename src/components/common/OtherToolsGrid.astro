---
import { useTranslations } from '../../i18n/utils';
import type { SupportedLocale } from '../../i18n/ui';

export interface Props {
  locale?: SupportedLocale;
  currentTool?: 'checker' | 'builder' | 'parser' | 'naming' | 'bulk';
}

const { locale = 'en', currentTool = 'checker' } = Astro.props;
const t = useTranslations(locale);

const allTools = [
  { key: 'checker', name: t('tools.checker.name'), desc: t('tools.checker.shortDesc'), path: `/${locale}/utm-checker` },
  { key: 'builder', name: t('tools.builder.name'), desc: t('tools.builder.shortDesc'), path: `/${locale}/utm-builder` },
  { key: 'parser', name: t('tools.parser.name'), desc: t('tools.parser.shortDesc'), path: `/${locale}/utm-parser` },
  { key: 'naming', name: t('tools.naming.name'), desc: t('tools.naming.shortDesc'), path: `/${locale}/utm-naming-generator` },
  { key: 'bulk', name: t('tools.bulk.name'), desc: t('tools.bulk.shortDesc'), path: `/${locale}/bulk-utm-builder` },
];

const filteredTools = allTools.filter((tool) => tool.key !== currentTool);
---

<section class="w-full max-w-[980px] mx-auto pt-12 sm:pt-16 mt-14 border-t border-[var(--border-hairline)]">
  <div class="mb-5 sm:mb-6">
    <h2 class="text-base sm:text-lg font-semibold tracking-tight text-[var(--text-primary)]">
      {t('otherTools.title')}
    </h2>
    <p class="text-xs sm:text-sm text-[var(--text-secondary)] mt-1">
      {t('otherTools.subtitle')}
    </p>
  </div>

  <div class="divide-y divide-[var(--border-hairline)] border-y border-[var(--border-hairline)]">
    {filteredTools.map((tool) => (
      <a
        href={tool.path}
        class="group flex flex-col sm:flex-row sm:items-center justify-between py-4 px-2.5 hover:bg-[var(--bg-subtle)]/50 transition-colors focus-ring rounded -mx-2.5"
      >
        <div class="flex flex-col sm:flex-row sm:items-baseline gap-1.5 sm:gap-4">
          <span class="text-[14.5px] sm:text-[15px] font-medium text-[var(--text-primary)] transition-colors">
            {tool.name}
          </span>
          <span class="text-xs sm:text-sm text-[var(--text-muted)] group-hover:text-[var(--text-secondary)] transition-colors line-clamp-1">
            {tool.desc}
          </span>
        </div>
        <div class="hidden sm:flex items-center text-xs text-[var(--text-muted)] group-hover:text-[var(--text-primary)] transition-colors shrink-0 ml-4">
          <svg class="w-4 h-4 transition-transform duration-150 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </a>
    ))}
  </div>
</section>
