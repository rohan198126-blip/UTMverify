---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSelector from './LanguageSelector.astro';
import { useTranslations } from '../../i18n/utils';
import type { SupportedLocale } from '../../i18n/ui';

export interface Props {
  locale?: SupportedLocale;
  currentPath?: string;
}

const { locale = 'en', currentPath = Astro.url.pathname } = Astro.props;
const t = useTranslations(locale);

const homePath = `/${locale}/`;
const tools = [
  { key: 'checker', name: t('tools.checker.name'), path: `/${locale}/utm-checker` },
  { key: 'builder', name: t('tools.builder.name'), path: `/${locale}/utm-builder` },
  { key: 'parser', name: t('tools.parser.name'), path: `/${locale}/utm-parser` },
  { key: 'naming', name: t('tools.naming.name'), path: `/${locale}/utm-naming-generator` },
  { key: 'bulk', name: t('tools.bulk.name'), path: `/${locale}/bulk-utm-builder` },
];

const guidesPath = `/${locale}/guides`;
const aboutPath = `/${locale}/about`;
const contactPath = `/${locale}/contact`;
---

<header class="header-root sticky top-0 z-40 w-full border-b border-[var(--border-hairline)] bg-[var(--bg-app)]/70 backdrop-blur-xl transition-colors duration-150">
  <div class="header-inner mx-auto flex h-[62px] max-w-[1040px] items-center justify-between px-4 sm:px-6 relative">
    <!-- Brand Wordmark & Logo -->
    <a
      href={homePath}
      class="inline-flex items-center gap-2.5 font-medium tracking-tight text-[var(--text-primary)] hover:opacity-90 transition-opacity focus-ring rounded"
      aria-label="UTMVerify home"
    >
      <img
        src="/utmverify-mark.svg"
        alt=""
        aria-hidden="true"
        width="22"
        height="22"
        class="w-[22px] h-[22px] shrink-0"
      />
      <span class="tracking-[-0.025em] font-semibold text-[16px] text-[var(--text-primary)]">
        UTM<span class="text-[var(--accent)]">Verify</span>
      </span>
    </a>

    <!-- Desktop Navigation — Clean, minimal editorial typography -->
    <nav class="hidden md:flex items-center gap-7 text-[13.5px] font-normal tracking-[-0.01em]">
      <!-- Tools Dropdown -->
      <div class="relative group" id="tools-dropdown-container">
        <button
          type="button"
          class="inline-flex items-center gap-1.5 py-1.5 text-[var(--text-secondary)] hover:text-[#ffffff] transition-colors focus-ring rounded cursor-pointer"
          aria-haspopup="true"
          aria-expanded="false"
          id="tools-menu-button"
        >
          <span>{t('nav.tools')}</span>
          <svg class="w-3.5 h-3.5 text-[var(--text-muted)] transition-transform duration-150 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="absolute left-0 top-full mt-1.5 w-52 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)]/95 p-1.5 shadow-2xl backdrop-blur-xl opacity-0 translate-y-1 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible transition-all duration-150 z-50">
          {tools.map((tool) => (
            <a
              href={tool.path}
              class={`block rounded-lg px-3 py-2 text-[13px] transition-colors ${
                currentPath === tool.path
                  ? 'bg-[var(--accent-subtle)] text-[var(--accent)] font-medium'
                  : 'text-[var(--text-secondary)] hover:bg-[var(--bg-subtle)] hover:text-[var(--text-primary)]'
              }`}
            >
              {tool.name}
            </a>
          ))}
        </div>
      </div>

      <a
        href={guidesPath}
        class={`py-1.5 transition-colors hover:text-[#ffffff] focus-ring rounded ${currentPath === guidesPath ? 'text-[#ffffff] font-medium' : 'text-[var(--text-secondary)]'}`}
      >
        {t('nav.guides')}
      </a>

      <a
        href={aboutPath}
        class={`py-1.5 transition-colors hover:text-[#ffffff] focus-ring rounded ${currentPath === aboutPath ? 'text-[#ffffff] font-medium' : 'text-[var(--text-secondary)]'}`}
      >
        {t('nav.about')}
      </a>

      <a
        href={contactPath}
        class={`py-1.5 transition-colors hover:text-[#ffffff] focus-ring rounded ${currentPath === contactPath ? 'text-[#ffffff] font-medium' : 'text-[var(--text-secondary)]'}`}
      >
        {t('nav.contact')}
      </a>
    </nav>

    <!-- Right Actions: Language Selector, Theme Toggle, Mobile Menu Button -->
    <div class="flex items-center gap-2 sm:gap-2.5">
      <LanguageSelector currentLocale={locale} currentPath={currentPath} />
      <ThemeToggle locale={locale} />

      <button
        type="button"
        id="mobile-menu-btn"
        aria-label={t('nav.menu')}
        class="inline-flex md:hidden items-center justify-center w-8 h-8 rounded-full border border-[var(--border-subtle)] bg-transparent text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] transition-colors focus-ring cursor-pointer"
      >
        <svg id="hamburger-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-[var(--border-hairline)] bg-[var(--bg-app)] px-4 py-4 transition-all"
  >
    <div class="flex flex-col space-y-1 text-sm">
      <div class="px-3 pb-1 text-[11px] font-medium tracking-wide text-[var(--text-muted)]">
        {t('nav.tools')}
      </div>
      {tools.map((tool) => (
        <a
          href={tool.path}
          class={`flex items-center justify-between rounded-lg px-3 py-2 text-sm transition-colors ${
            currentPath === tool.path
              ? 'bg-[var(--accent-subtle)] text-[var(--accent)] font-medium'
              : 'text-[var(--text-secondary)] hover:bg-[var(--bg-surface)] hover:text-[var(--text-primary)]'
          }`}
        >
          <span>{tool.name}</span>
        </a>
      ))}
      <div class="my-2 border-t border-[var(--border-hairline)]"></div>
      <a
        href={guidesPath}
        class="px-3 py-2 text-sm text-[var(--text-secondary)] hover:bg-[var(--bg-surface)] hover:text-[var(--text-primary)] rounded-lg transition-colors"
      >
        {t('nav.guides')}
      </a>
      <a
        href={aboutPath}
        class="px-3 py-2 text-sm text-[var(--text-secondary)] hover:bg-[var(--bg-surface)] hover:text-[var(--text-primary)] rounded-lg transition-colors"
      >
        {t('nav.about')}
      </a>
      <a
        href={contactPath}
        class="px-3 py-2 text-sm text-[var(--text-secondary)] hover:bg-[var(--bg-surface)] hover:text-[var(--text-primary)] rounded-lg transition-colors"
      >
        {t('nav.contact')}
      </a>
    </div>
  </div>
</header>

<script>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const burger = document.getElementById('hamburger-icon');
    const close = document.getElementById('close-icon');

    if (!btn || !menu || !burger || !close) return;

    btn.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        burger.classList.add('hidden');
        close.classList.remove('hidden');
      } else {
        menu.classList.add('hidden');
        burger.classList.remove('hidden');
        close.classList.add('hidden');
      }
    });
  }

  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
