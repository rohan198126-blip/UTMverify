---
import { LOCALES, SUPPORTED_LOCALES, type SupportedLocale } from '../../i18n/ui';
import { getLocalizedPath, useTranslations } from '../../i18n/utils';

export interface Props {
  currentLocale: SupportedLocale;
  currentPath?: string;
}

const { currentLocale, currentPath = Astro.url.pathname } = Astro.props;
const t = useTranslations(currentLocale);
const currentLocaleInfo = LOCALES[currentLocale];
---

<div class="relative inline-block text-left" id="language-selector-root">
  <button
    type="button"
    id="lang-menu-button"
    aria-expanded="false"
    aria-haspopup="true"
    aria-label={t('nav.language')}
    title={t('nav.language')}
    class="inline-flex items-center gap-1.5 h-9 px-2.5 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-strong)] transition-colors focus-ring"
  >
    <!-- Minimal Globe Icon -->
    <svg class="w-3.5 h-3.5 text-[var(--text-muted)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
    </svg>
    <span class="max-w-[70px] truncate">{currentLocaleInfo.name}</span>
    <svg class="w-3 h-3 text-[var(--text-muted)] shrink-0 transition-transform duration-150" id="lang-arrow-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div
    id="lang-dropdown-menu"
    role="menu"
    aria-orientation="vertical"
    aria-labelledby="lang-menu-button"
    class="hidden absolute right-0 mt-1.5 w-40 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-1 shadow-lg backdrop-blur-md z-50 transition-all duration-150"
  >
    {SUPPORTED_LOCALES.map((localeCode) => {
      const info = LOCALES[localeCode];
      const isSelected = localeCode === currentLocale;
      const targetUrl = getLocalizedPath(currentPath, localeCode);

      return (
        <a
          href={targetUrl}
          role="menuitem"
          class={`flex items-center justify-between px-3 py-1.5 rounded-md text-xs font-medium transition-colors ${
            isSelected
              ? 'bg-[var(--accent-subtle)] text-[var(--accent)] font-semibold'
              : 'text-[var(--text-secondary)] hover:bg-[var(--bg-subtle)] hover:text-[var(--text-primary)]'
          }`}
          data-locale={localeCode}
        >
          <span>{info.name}</span>
          {isSelected && (
            <svg class="w-3.5 h-3.5 text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
          )}
        </a>
      );
    })}
  </div>
</div>

<script>
  function initLanguageSelector() {
    const btn = document.getElementById('lang-menu-button');
    const menu = document.getElementById('lang-dropdown-menu');
    const arrow = document.getElementById('lang-arrow-icon');
    const root = document.getElementById('language-selector-root');

    if (!btn || !menu || !arrow || !root) return;

    function toggleMenu(open?: boolean) {
      const isExpanded = btn?.getAttribute('aria-expanded') === 'true';
      const shouldOpen = open !== undefined ? open : !isExpanded;

      btn?.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
      if (shouldOpen) {
        menu?.classList.remove('hidden');
        arrow?.classList.add('rotate-180');
      } else {
        menu?.classList.add('hidden');
        arrow?.classList.remove('rotate-180');
      }
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) {
        toggleMenu(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        toggleMenu(false);
      }
    });
  }

  initLanguageSelector();
  document.addEventListener('astro:after-swap', initLanguageSelector);
</script>
